{
  "name": "booru",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "bench:avif": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/bench/sharp-avif-bench.mts",
    "db:list": "node --env-file-if-exists=.env.local scripts/migrate.mjs list",
    "db:push": "node --env-file-if-exists=.env.local scripts/migrate.mjs push",
    "db:reset": "node --env-file-if-exists=.env.local scripts/migrate.mjs reset",
    "desktop:dev": "npm run dev -w desktop",
    "desktop:package": "npm run package -w desktop"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "next": "16.3.3",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true,
    "electron@44.0.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  }
}
