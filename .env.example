# All four are required to build the desktop uploader: it has no setup screen, so which
# board an installer talks to is read from here and compiled in (packages/desktop).
# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
# Server-only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# Public origin, used for canonical URLs, OpenGraph, robots.txt and sitemap.xml.
# The website can go without it (Vercel supplies the deployment URL); the desktop build
# cannot — it is how a finished post is opened on the board.
NEXT_PUBLIC_SITE_URL=https://booru.example.com
