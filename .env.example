# Three Postgres logins, because they are three different powers. db/README.md creates
# the roles; the reasoning is in db/migrations/0001_baseline.sql.

# The website's, and the only one Vercel ever gets. Reads every table, writes exactly one
# column — the view counter — and the database enforces that, not the code.
DATABASE_URL=postgresql://booru_web:YOUR_PASSWORD@YOUR_HOST/neondb?sslmode=require

# The desktop app's, compiled into its bundle at build time. Reads and writes every row;
# may not create, alter or drop anything. Never deployed to the website.
DATABASE_URL_APP=postgresql://booru_app:YOUR_PASSWORD@YOUR_HOST/neondb?sslmode=require

# The migration runner's, and nothing else's — `npm run db:push` / `db:reset`. Owns the
# tables. Never deployed and never compiled into anything. On Neon this is the role the
# project came with (`neondb_owner`), not one you make.
DATABASE_URL_OWNER=postgresql://neondb_owner:YOUR_PASSWORD@YOUR_HOST/neondb?sslmode=require

# Where images are served from — the R2 bucket's public origin, no trailing slash. Public
# by definition: it is in the markup of every page.
NEXT_PUBLIC_CDN_URL=https://img.booru.example.com

# Writing to that bucket. The desktop app compiles these in; the website has none of them,
# because it never writes an image.
R2_ACCOUNT_ID=YOUR_ACCOUNT_ID
R2_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY
R2_BUCKET=booru

# Public origin, used for canonical URLs, OpenGraph, robots.txt and sitemap.xml.
# The website can go without it (Vercel supplies the deployment URL); the desktop build
# cannot — it is how a finished post is opened on the board.
NEXT_PUBLIC_SITE_URL=https://booru.example.com

# What the board is called: the wordmark, the tab title, every OpenGraph card. Optional —
# an unset one reads as "Booru", which is a board that has not been named rather than
# somebody else's.
NEXT_PUBLIC_SITE_NAME=Booru
