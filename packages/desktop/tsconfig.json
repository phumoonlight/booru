{
  // One program for all three sides. Electron's main process really does have a
  // narrower world than the window, but the split that would express it (a node
  // config and a web config, joined by project references) needs `composite`, and
  // `composite` insists every file in the program sit under this directory — which
  // the whole design rules out: the pipeline, the write path and the compressors are
  // compiled out of ../common. So: one config, DOM included, and `@supabase/auth-js`
  // gets the `Storage` type its session adapter is declared against.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    // No `baseUrl`: it is deprecated in TypeScript 6, and these mappings never needed
    // it — without one, `paths` resolves relative to this file, which is what the
    // `../` below already assumes.
    "paths": {
      // The shared package, and the only thing outside this directory that this app
      // compiles. It used to be the website's own src/, under two aliases — `@web/*`
      // for the imports written here and `@/*` because the files over there spelled
      // each other that way, which meant the desktop build inherited the Next app's
      // internal convention. One name now, pointing at code that belongs to neither
      // front end.
      "@common/*": ["../common/src/*"]
    }
  },
  "include": ["electron.vite.config.ts", "src/**/*.ts", "src/**/*.tsx"]
}
