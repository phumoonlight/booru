{
  "manifest_version": 3,
  "name": "Booru explorer",
  "version": "1.5.0",
  "key": "",
  "description": "Hover a booru thumbnail to see it big: the thumbnail enlarged instantly, or the board's sample on request.",
  "permissions": ["storage"],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.gelbooru.com/*",
        "*://*.safebooru.org/*",
        "*://*.rule34.xxx/*",
        "*://*.xbooru.com/*",
        "*://*.tbib.org/*",
        "*://*.donmai.us/*",
        "*://*.konachan.com/*",
        "*://*.konachan.net/*",
        "*://*.pixiv.net/*"
      ],
      "js": ["src/content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
