{
  "manifest_version": 3,
  "name": "Booru explorer",
  "version": "1.1.0",
  "description": "Hover a booru thumbnail to see it full size, and mark the posts you have already been through so they fade out of the next search.",
  "permissions": ["storage", "unlimitedStorage", "downloads"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "options_page": "src/options.html",
  "content_scripts": [
    {
      "matches": [
        "*://*.gelbooru.com/*",
        "*://*.safebooru.org/*",
        "*://*.rule34.xxx/*",
        "*://*.xbooru.com/*",
        "*://*.tbib.org/*",
        "*://*.donmai.us/*",
        "*://*.konachan.com/*",
        "*://*.konachan.net/*"
      ],
      "js": ["src/content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
